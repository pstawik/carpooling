---
const { user, profile } = Astro.locals;
const isDashboard = Astro.url.pathname === "/dashboard";
// Token classes only (see the UI rules in AGENTS.md); --link is the readable purple for text links on the dark surface.
const linkClass =
  "text-link hover:text-foreground focus-visible:outline-ring inline-flex min-h-11 items-center rounded-sm transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2";
---

<div class="border-border bg-card/50 text-foreground/80 mb-4 flex flex-wrap items-center justify-between gap-x-3 rounded-xl border px-4 py-1 text-sm">
  {user ? (
    <>
      <span class="text-muted-foreground min-w-0 truncate">{profile?.nick ?? user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/dashboard" class:list={linkClass} aria-current={isDashboard ? "page" : undefined}>
          Panel
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class:list={linkClass}>
            Wyloguj
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-muted-foreground">Nie zalogowano</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class:list={linkClass}>
          Zaloguj się
        </a>
        <a href="/auth/signup" class:list={linkClass}>
          Zarejestruj się
        </a>
      </div>
    </>
  )}
</div>
