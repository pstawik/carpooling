---
import { CircleAlert, CircleCheck } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import {
  cardClass,
  hintLinkClass,
  inputClass,
  labelClass,
  linkButtonClass,
  listItemClass,
  phoneLinkClass,
  subHeadingClass,
  submitClass,
} from "@/components/groups/group-page-classes";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { groupErrorMessage } from "@/lib/services/group-errors";
import { goingLabel, missingLabel, seatsLabel } from "@/lib/plural";
import { telHref } from "@/lib/tel";

// Kitchen sink for the event plan: every cell of the 7-state matrix on one page, for the visual gate.
// Dev only; a production build answers 404. No Supabase queries: all data is written in the page.
if (!import.meta.env.DEV) {
  return Astro.rewrite("/404");
}

const groupId = "00000000-0000-4000-8000-000000000001";
const eventId = "00000000-0000-4000-8000-000000000101";
const sampleChild = { id: "00000000-0000-4000-8000-000000000201", name: "Zosia" };
const sampleDriver = { nick: "Ania", seats: 3, phone: "+48 600 100 200" };
// The view's text and link helpers (src/lib/), so the sink renders exactly what the view renders.
const driverTel = telHref(sampleDriver.phone);

// The view's texts for the error codes, so the sink shows exactly what the redirect shows.
const seatsError = groupErrorMessage("invalid_driver_seats", null);
const attendanceLockedError = groupErrorMessage("attendance_locked", null);
const unknownError = groupErrorMessage("unknown", null);

// The view's class constants come from group-page-classes, so the sink shows what the view shows.
// These two style only the sink's own state labels, which the view does not have.
const stateHeadingClass = "mb-1 text-lg font-semibold";
const stateNoteClass = "text-muted-foreground mb-4 text-sm";
---

<Layout title="Kitchen sink: plan terminu">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-xl">
      <h1 class="text-foreground mb-2 text-2xl font-bold break-words">Kitchen sink: plan terminu</h1>
      <p class="text-muted-foreground mb-6 text-sm">
        Strona deweloperska: elementy planu terminu w 7 stanach. Dane są przykładowe, a formularze nie działają
        (wysyłają żądania do prawdziwych endpointów, które odrzucą nieistniejącą grupę i termin).
      </p>

      <Card role="region" aria-labelledby="state-default" className={cardClass}>
        <h2 id="state-default" class:list={stateHeadingClass}>
          default
        </h2>
        <p class:list={stateNoteClass}>Tylko tokeny i komponenty z ui/ oraz stałe z group-page-classes.</p>

        <h3 class:list={subHeadingClass}>Bilans miejsc: niedobór</h3>
        <p class="mb-3 break-words">{`${goingLabel(3)} · ${seatsLabel(2)}`}</p>
        <Alert variant="destructive" role="alert" className="mb-4">
          <CircleAlert />
          <AlertDescription className="font-semibold break-words">{missingLabel(1)}</AlertDescription>
        </Alert>

        <h3 class:list={subHeadingClass}>Bilans miejsc: wystarcza</h3>
        <p class="mb-3 break-words">{`${goingLabel(3)} · ${seatsLabel(4)}`}</p>
        <Alert variant="success" role="status" className="mb-4">
          <CircleCheck />
          <AlertDescription className="font-semibold break-words">Miejsc wystarcza</AlertDescription>
        </Alert>

        <h3 class:list={subHeadingClass}>Twoje dzieci</h3>
        <ul class="mb-4 space-y-3">
          <li class:list={listItemClass}>
            <p class="break-words">
              <span class="font-medium">{sampleChild.name}</span>
              <span class="text-muted-foreground text-sm"> — jedzie</span>
            </p>
            <div class="mt-2 grid grid-cols-2 gap-2">
              {[
                { going: "true", text: "Jedzie", on: true },
                { going: "false", text: "Nie jedzie", on: false },
              ].map((choice) => (
                <form method="POST" action="/api/groups/events/attendance" class="min-w-0">
                  <input type="hidden" name="group_id" value={groupId} />
                  <input type="hidden" name="event_id" value={eventId} />
                  <input type="hidden" name="child_id" value={sampleChild.id} />
                  <input type="hidden" name="going" value={choice.going} />
                  <Button
                    type="submit"
                    variant={choice.on ? "default" : "outline"}
                    aria-pressed={choice.on ? "true" : "false"}
                    className={submitClass}
                  >
                    {choice.text}
                  </Button>
                </form>
              ))}
            </div>
          </li>
        </ul>

        <h3 class:list={subHeadingClass}>Plan dzieci</h3>
        <ul class="mb-4 space-y-1 text-sm">
          <li class="break-words">
            <span class="font-medium">Zosia</span>
            <span class="text-muted-foreground"> (Ania)</span>
          </li>
          <li class="break-words">
            <span class="font-medium">Kuba</span>
            <span class="text-muted-foreground"> (Marek)</span>
            <Badge variant="secondary" className="ml-1">
              bez deklaracji
            </Badge>
          </li>
        </ul>

        <h3 class:list={subHeadingClass}>Twój przejazd</h3>
        <form method="POST" action="/api/groups/events/driver" class="mb-4 space-y-2">
          <input type="hidden" name="group_id" value={groupId} />
          <input type="hidden" name="event_id" value={eventId} />
          <input type="hidden" name="action" value="set" />
          <label for="sink-default-seats" class:list={labelClass}>
            Wolne miejsca dla dzieci (1–8)
          </label>
          <Input
            id="sink-default-seats"
            name="seats"
            type="number"
            inputMode="numeric"
            min="1"
            max="8"
            step="1"
            required
            placeholder="np. 3"
            className={inputClass}
          />
          <Button type="submit" className={submitClass}>
            Jadę jako kierowca
          </Button>
        </form>

        <h3 class:list={subHeadingClass}>Kierowcy</h3>
        <ul class="space-y-2 text-sm">
          <li class:list={listItemClass}>
            <p class="break-words">
              <span class="font-medium">{sampleDriver.nick}</span>
              <span class="text-muted-foreground"> — {seatsLabel(sampleDriver.seats)}</span>
            </p>
            <a href={driverTel} class:list={phoneLinkClass}>
              {sampleDriver.phone}
            </a>
          </li>
        </ul>
      </Card>

      <Card role="region" aria-labelledby="state-hover" className={cardClass}>
        <h2 id="state-hover" class:list={stateHeadingClass}>
          hover
        </h2>
        <p class:list={stateNoteClass}>
          Najedź kursorem: przyciski zmieniają tło (primary/90, input), linki telefonu i strony grupy dostają
          podkreślenie.
        </p>
        <div class="mb-4 grid grid-cols-2 gap-2">
          <Button type="button" aria-pressed="true" className={submitClass}>
            Jedzie
          </Button>
          <Button type="button" variant="outline" aria-pressed="false" className={submitClass}>
            Nie jedzie
          </Button>
        </div>
        <a href={driverTel} class:list={phoneLinkClass}>
          {sampleDriver.phone}
        </a>
        <p class="text-muted-foreground text-sm">
          Nie masz jeszcze dziecka w tej grupie.{" "}
          <a href="#state-hover" class:list={hintLinkClass}>
            Dodaj dziecko na stronie grupy
          </a>
        </p>
      </Card>

      <Card role="region" aria-labelledby="state-focus" className={cardClass}>
        <h2 id="state-focus" class:list={stateHeadingClass}>
          focus-visible
        </h2>
        <p class:list={stateNoteClass}>
          Przejdź klawiszem Tab: każdy przycisk, pole i link pokazuje obwódkę w kolorze tokenu --ring. Kliknięcie myszą
          nie pokazuje obwódki na linkach.
        </p>
        <div class="space-y-2">
          <div class="grid grid-cols-2 gap-2">
            <Button type="button" aria-pressed="false" variant="outline" className={submitClass}>
              Jedzie
            </Button>
            <Button type="button" aria-pressed="true" className={submitClass}>
              Nie jedzie
            </Button>
          </div>
          <label for="sink-focus-seats" class:list={labelClass}>
            Wolne miejsca dla dzieci (1–8)
          </label>
          <Input
            id="sink-focus-seats"
            type="number"
            inputMode="numeric"
            min="1"
            max="8"
            step="1"
            placeholder="np. 3"
            className={inputClass}
          />
          <Button type="button" className={submitClass}>
            Zapisz miejsca
          </Button>
          <Button type="button" variant="outline" className={submitClass}>
            Wycofaj
          </Button>
          <a href={driverTel} class:list={phoneLinkClass}>
            {sampleDriver.phone}
          </a>
          <a href="#state-focus" class:list={linkButtonClass}>
            Wróć do grupy
          </a>
        </div>
      </Card>

      <Card role="region" aria-labelledby="state-disabled" className={cardClass}>
        <h2 id="state-disabled" class:list={stateHeadingClass}>
          disabled
        </h2>
        <p class:list={stateNoteClass}>
          N/A — plan nie wygasza kontrolek. Po starcie terminu przyciski deklaracji i formularz kierowcy są ukrywane, a
          zamiast nich widać stan „termin się rozpoczął” (poniżej).
        </p>
        <h3 class:list={subHeadingClass}>Twoje dzieci</h3>
        <p class="text-muted-foreground mb-3 text-sm">Termin się rozpoczął — deklaracje są tylko do odczytu.</p>
        <ul class="mb-4 space-y-3">
          <li class:list={listItemClass}>
            <p class="break-words">
              <span class="font-medium">{sampleChild.name}</span>
              <span class="text-muted-foreground text-sm"> — bez deklaracji</span>
            </p>
          </li>
        </ul>
        <h3 class:list={subHeadingClass}>Twój przejazd</h3>
        <p class="mb-2 break-words">{`Jedziesz jako kierowca: ${seatsLabel(sampleDriver.seats)}`}</p>
        <p class="text-muted-foreground text-sm">Termin się rozpoczął — deklaracja kierowcy jest tylko do odczytu.</p>
      </Card>

      <Card role="region" aria-labelledby="state-error" className={cardClass}>
        <h2 id="state-error" class:list={stateHeadingClass}>
          error
        </h2>
        <p class:list={stateNoteClass}>
          Komunikat w karcie, do której prowadzi przekierowanie; token destructive, ikona i tekst (nie tylko kolor).
        </p>

        <h3 class:list={subHeadingClass}>Twój przejazd: invalid_driver_seats</h3>
        <Alert variant="destructive" role="alert" id="sink-error-driver" className="mb-3">
          <CircleAlert />
          <AlertDescription className="break-words">{seatsError}</AlertDescription>
        </Alert>
        <div class="mb-4 space-y-2">
          <label for="sink-error-seats" class:list={labelClass}>
            Wolne miejsca dla dzieci (1–8)
          </label>
          <Input
            id="sink-error-seats"
            type="number"
            inputMode="numeric"
            min="1"
            max="8"
            step="1"
            placeholder="np. 3"
            aria-invalid="true"
            aria-describedby="sink-error-driver"
            className={inputClass}
          />
          <Button type="button" className={submitClass}>
            Jadę jako kierowca
          </Button>
        </div>

        <h3 class:list={subHeadingClass}>Twoje dzieci: attendance_locked</h3>
        <Alert variant="destructive" role="alert" className="mb-4">
          <CircleAlert />
          <AlertDescription className="break-words">{attendanceLockedError}</AlertDescription>
        </Alert>

        <h3 class:list={subHeadingClass}>Góra strony: unknown</h3>
        <Alert variant="destructive" role="alert" className="mb-4">
          <CircleAlert />
          <AlertDescription className="break-words">{unknownError}</AlertDescription>
        </Alert>

        <h3 class:list={subHeadingClass}>Błąd ładowania planu</h3>
        <Alert variant="destructive" role="alert">
          <CircleAlert />
          <AlertDescription>Nie udało się wczytać planu.</AlertDescription>
        </Alert>
      </Card>

      <Card role="region" aria-labelledby="state-empty" className={cardClass}>
        <h2 id="state-empty" class:list={stateHeadingClass}>
          empty
        </h2>
        <p class:list={stateNoteClass}>Brak danych: prawdziwy pusty stan, nie pusta ramka.</p>

        <h3 class="mb-2 text-lg font-semibold">Bilans miejsc</h3>
        <p class="mb-3 break-words">{`${goingLabel(0)} · ${seatsLabel(0)}`}</p>
        <p class="text-muted-foreground mb-4 text-sm">Żadne dziecko jeszcze nie jedzie</p>

        <h3 class="mb-3 text-lg font-semibold">Twoje dzieci</h3>
        <p class="text-muted-foreground mb-4 text-sm">
          Nie masz jeszcze dziecka w tej grupie.{" "}
          <a href="#state-empty" class:list={hintLinkClass}>
            Dodaj dziecko na stronie grupy
          </a>
        </p>

        <h3 class="mb-3 text-lg font-semibold">Plan dzieci</h3>
        <div class="mb-4">
          <h4 class:list={subHeadingClass}>Jadą (0)</h4>
          <p class="text-muted-foreground mb-4 text-sm">Żadne dziecko jeszcze nie jedzie.</p>
          <h4 class:list={subHeadingClass}>Nie jadą (0)</h4>
          <p class="text-muted-foreground text-sm">Brak dzieci na tej liście.</p>
        </div>

        <h3 class="mb-3 text-lg font-semibold">Kierowcy (0)</h3>
        <p class="text-muted-foreground text-sm">Nikt jeszcze nie zadeklarował się jako kierowca</p>
      </Card>

      <Card role="region" aria-labelledby="state-loading" className={cardClass}>
        <h2 id="state-loading" class:list={stateHeadingClass}>
          loading
        </h2>
        <p class="text-muted-foreground text-sm">
          N/A — SSR, brak doczytywania danych. Plan terminu dostaje wszystkie dane na serwerze przed wysłaniem HTML, a
          deklaracje są zwykłymi formularzami (pełne przeładowanie), więc nie ma stanu ładowania ani przeskoku układu.
        </p>
      </Card>
    </div>
  </div>
</Layout>
