---
import { Car, ClipboardList, Link2, UserCheck } from "lucide-react";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;

const steps = [
  {
    icon: Link2,
    title: "Dołącz do grupy",
    text: "Administrator grupy wysyła link zaproszeniowy. Jedna grupa to jedne zajęcia, np. „Judo – wtorki”.",
  },
  {
    icon: UserCheck,
    title: "Zadeklaruj, kto jedzie",
    text: "Zaznacz, czy Twoje dziecko jedzie na termin, i zgłoś się jako kierowca z liczbą wolnych miejsc.",
  },
  {
    icon: ClipboardList,
    title: "Sprawdź plan terminu",
    text: "Widzisz, kto jedzie, kto wiezie i czy miejsc wystarczy. Dzieci bez deklaracji są wyraźnie oznaczone.",
  },
];

const primaryLink =
  "inline-flex min-h-11 items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500";
const secondaryLink =
  "inline-flex min-h-11 items-center justify-center rounded-lg border border-white/20 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-white/10";
---

<Layout title="CarPooling – przejazdy na zajęcia">
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"></div>
    <div class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"></div>

    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />

      <main>
        <section class="mx-auto flex max-w-3xl flex-col items-center px-2 py-16 text-center sm:py-24">
          <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl border border-white/10 bg-white/10 text-purple-200 backdrop-blur-xl">
            <Car size={32} aria-hidden="true" />
          </div>
          <h1 class="mb-4 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl">
            CarPooling
          </h1>
          <p class="mb-4 text-xl font-medium text-white sm:text-2xl">Aplikacja do zarządzania przejazdami na zajęcia</p>
          <p class="mb-10 max-w-xl text-base text-blue-100/70 sm:text-lg">
            Koniec z ustalaniem na czacie, kto wiezie dzieci na trening. Rodzice z grupy w jednym miejscu deklarują
            obecność dzieci i wolne miejsca w aucie.
          </p>
          <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
            {user ? (
              <a href="/dashboard" class:list={primaryLink}>
                Przejdź do panelu
              </a>
            ) : (
              <>
                <a href="/auth/signup" class:list={primaryLink}>
                  Załóż konto
                </a>
                <a href="/auth/signin" class:list={secondaryLink}>
                  Zaloguj się
                </a>
              </>
            )}
          </div>
        </section>

        <section class="mx-auto max-w-4xl pb-16" aria-labelledby="how-it-works">
          <h2 id="how-it-works" class="mb-6 text-center text-2xl font-semibold text-white">
            Jak to działa
          </h2>
          <ol class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            {steps.map((step, index) => (
              <li class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
                <div class="mb-4 flex items-center gap-3 text-purple-300">
                  <step.icon size={24} aria-hidden="true" />
                  <span class="text-sm font-medium text-blue-100/60">Krok {index + 1}</span>
                </div>
                <h3 class="mb-2 text-lg font-semibold text-white">{step.title}</h3>
                <p class="text-sm leading-relaxed text-blue-100/70">{step.text}</p>
              </li>
            ))}
          </ol>
        </section>
      </main>
    </div>
  </div>
</Layout>
