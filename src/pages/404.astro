---
import Layout from "@/layouts/Layout.astro";

// Pages reach this via Astro.rewrite("/404"); keep the status explicit either way.
Astro.response.status = 404;
---

<Layout title="Nie znaleziono strony">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-6 text-center text-white backdrop-blur-xl sm:p-8">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Nie znaleziono strony
      </h1>
      <p class="text-blue-100/80">Ta strona nie istnieje albo nie masz do niej dostępu.</p>
      <a
        href="/dashboard"
        class="mt-6 inline-flex min-h-11 items-center rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
      >
        Wróć do panelu
      </a>
    </div>
  </div>
</Layout>
