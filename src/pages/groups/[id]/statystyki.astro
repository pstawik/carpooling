---
import { CircleAlert } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { cardClass, linkButtonClass, listItemClass } from "@/components/groups/group-page-classes";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card } from "@/components/ui/card";
import { createClient } from "@/lib/supabase";
import { getGroupWithAdmins } from "@/lib/services/groups";
import { countFinishedEvents, getGroupStats, type GroupStats } from "@/lib/services/stats";
import { drivesLabel } from "@/lib/plural";

// Engagement statistics of the group (FR-017): drives per member and presence / absence per child
// over finished events. Raw counts, alphabetical, no ranking. Middleware guarantees a signed-in
// user on /groups/*. Non-members, unknown and malformed ids all get the same 404.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;
if (!supabase || !user) {
  return Astro.rewrite("/404");
}

const group = await getGroupWithAdmins(supabase, Astro.params.id ?? "", user.id);
if (!group) {
  return Astro.rewrite("/404");
}

// The finished-events count uses the Worker's clock, the lists use now() in the database. They can
// disagree only for an event starting within the same instant, and agree again on the next load.
let finishedCount = 0;
let stats: GroupStats | null;
try {
  const [count, groupStats] = await Promise.all([
    countFinishedEvents(supabase, group.id, new Date()),
    getGroupStats(supabase, group.id),
  ]);
  finishedCount = count;
  stats = groupStats;
} catch (loadError) {
  // eslint-disable-next-line no-console -- surfaces in Cloudflare Worker logs
  console.error(loadError);
  stats = null;
}
---

<Layout title={`Statystyki · ${group.name}`}>
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-xl">
      <Topbar />

      <header class="mb-4">
        <p class="text-muted-foreground mb-1 text-sm break-words">{group.name}</p>
        <h1 class="text-foreground text-2xl font-bold">Statystyki</h1>
      </header>

      {stats === null ? (
        <Alert variant="destructive" role="alert" className="mb-6">
          <CircleAlert />
          <AlertDescription>Nie udało się wczytać statystyk.</AlertDescription>
        </Alert>
      ) : (
        <>
          {finishedCount === 0 ? (
            <Card className={cardClass}>
              <p class="text-muted-foreground text-sm">
                Brak zakończonych terminów — statystyki pojawią się po pierwszym terminie.
              </p>
            </Card>
          ) : (
            <>
              <Card id="podsumowanie" role="region" aria-labelledby="podsumowanie-heading" className={cardClass}>
                <h2 id="podsumowanie-heading" class="mb-2 text-lg font-semibold">
                  Zakończone terminy: {finishedCount}
                </h2>
                <p class="text-muted-foreground text-sm">
                  Przejazd liczy się, gdy na termin jechało co najmniej jedno dziecko. Nieobecność to „nie jedzie” albo
                  brak deklaracji, liczone od dodania dziecka.
                </p>
              </Card>

              <Card id="kierowcy" role="region" aria-labelledby="kierowcy-heading" className={cardClass}>
                <h2 id="kierowcy-heading" class="mb-3 text-lg font-semibold">
                  Kierowcy
                </h2>
                <ul class="space-y-2 text-sm">
                  {stats.drivers.map((driver) => (
                    <li class:list={listItemClass}>
                      <p class="font-medium break-words">{driver.nick ?? "Członek grupy"}</p>
                      <p class="text-muted-foreground">{drivesLabel(driver.drives)}</p>
                    </li>
                  ))}
                </ul>
              </Card>

              <Card id="dzieci" role="region" aria-labelledby="dzieci-heading" className={cardClass}>
                <h2 id="dzieci-heading" class="mb-3 text-lg font-semibold">
                  Dzieci
                </h2>
                {stats.children.length === 0 ? (
                  <p class="text-muted-foreground text-sm">W grupie nie ma jeszcze dzieci.</p>
                ) : (
                  <ul class="space-y-2 text-sm">
                    {stats.children.map((child) => (
                      <li class:list={listItemClass}>
                        <p class="break-words">
                          <span class="font-medium">{child.name}</span>
                          {child.parentNick && <span class="text-muted-foreground"> ({child.parentNick})</span>}
                        </p>
                        <p class="text-muted-foreground">
                          Obecności: {child.present} · Nieobecności: {child.absent}
                        </p>
                      </li>
                    ))}
                  </ul>
                )}
              </Card>
            </>
          )}
        </>
      )}

      <a href={`/groups/${group.id}`} class:list={linkButtonClass}>
        Wróć do grupy
      </a>
    </div>
  </div>
</Layout>
