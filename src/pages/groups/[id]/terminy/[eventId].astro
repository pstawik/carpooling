---
import { CircleAlert, CircleCheck } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import {
  cardClass,
  inputClass,
  labelClass,
  linkButtonClass,
  listItemClass,
  phoneLinkClass,
  planLinkClass,
  submitClass,
} from "@/components/groups/group-page-classes";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { createClient } from "@/lib/supabase";
import { cn } from "@/lib/utils";
import { getGroupWithAdmins } from "@/lib/services/groups";
import { getGroupEvent, hasStarted } from "@/lib/services/events";
import { listGroupChildren } from "@/lib/services/children";
import { buildChildPlan, listEventAttendance, type AttendanceStatus, type ChildPlan } from "@/lib/services/attendance";
import { buildSeatBalance, listEventDrivers, type EventDriverEntry, type SeatBalance } from "@/lib/services/drivers";
import { groupErrorMessage } from "@/lib/services/group-errors";
import { pluralPl, seatsLabel } from "@/lib/plural";
import { formatEventStart } from "@/lib/time";

// The full plan of one event (US-01): seat balance, the member's children, the child plan, their
// own driver declaration and the drivers. Middleware guarantees a signed-in user on /groups/*.
// Non-members, an event of another group, unknown and malformed ids all get the same 404.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;
if (!supabase || !user) {
  return Astro.rewrite("/404");
}

const group = await getGroupWithAdmins(supabase, Astro.params.id ?? "", user.id);
if (!group) {
  return Astro.rewrite("/404");
}
const event = await getGroupEvent(supabase, group.id, Astro.params.eventId ?? "");
if (!event) {
  return Astro.rewrite("/404");
}

// One `now` per request, the same rule as the group page's upcoming / past split. The database
// enforces the lock anyway; this only decides whether the buttons are shown.
const locked = hasStarted(event, new Date());

// Only the attendance and driver endpoints' codes are shown here, each in the card its redirect
// lands on: `attendance_locked` in #twoje-dzieci (a successful declaration reopens the plan at the top), the driver codes in #twoj-przejazd. The generic
// ones are shown at the top of the page.
const errorCode = Astro.url.searchParams.get("error");
const lockedError = errorCode === "attendance_locked" ? groupErrorMessage(errorCode, null) : null;
const driverError =
  errorCode === "driver_locked" || errorCode === "invalid_driver_seats" ? groupErrorMessage(errorCode, null) : null;
const error = errorCode === "not_configured" || errorCode === "unknown" ? groupErrorMessage(errorCode, null) : null;
// The seats message is tied to the field it is about, so a screen reader announces it there.
const seatsInvalid = errorCode === "invalid_driver_seats";

// A failed children, attendance or drivers query must not take the whole page down.
let plan: ChildPlan | null;
let drivers: EventDriverEntry[] = [];
let balance: SeatBalance | null = null;
try {
  const [children, attendance, eventDrivers] = await Promise.all([
    listGroupChildren(supabase, group.id),
    listEventAttendance(supabase, event.id),
    listEventDrivers(supabase, event.id),
  ]);
  plan = buildChildPlan(children, attendance, user.id);
  drivers = eventDrivers;
  // Only children declared as going count; "bez deklaracji" does not add to the demand.
  balance = buildSeatBalance(drivers, plan.going.length);
} catch (loadError) {
  // eslint-disable-next-line no-console -- surfaces in Cloudflare Worker logs
  console.error(loadError);
  plan = null;
}
const myDriver = drivers.find((driver) => driver.userId === user.id) ?? null;

/** "Jedzie 0 dzieci", "Jedzie 1 dziecko", "Jadą 2 dzieci", "Jedzie 5 dzieci", "Jadą 22 dzieci". */
function goingLabel(count: number): string {
  return `${pluralPl(count, "Jedzie", "Jadą", "Jedzie")} ${count} ${pluralPl(count, "dziecko", "dzieci", "dzieci")}`;
}

/** "Brakuje 1 miejsca", "Brakuje 2 miejsc", "Brakuje 5 miejsc" (genitive). */
function missingLabel(count: number): string {
  return `Brakuje ${count} ${count === 1 ? "miejsca" : "miejsc"}`;
}

/** A dialable `tel:` target: digits and a leading plus only. */
function telHref(phone: string): string {
  return `tel:${phone.replace(/[^\d+]/g, "")}`;
}

const label = formatEventStart(event.startsAt);
const statusLabels: Record<AttendanceStatus, string> = {
  going: "jedzie",
  not_going: "nie jedzie",
  undeclared: "bez deklaracji",
};
---

<Layout title={`${label} · ${group.name}`}>
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-xl">
      <Topbar />

      <header class="mb-4">
        <p class="text-muted-foreground mb-1 text-sm break-words">{group.name}</p>
        <h1 class="text-foreground text-2xl font-bold break-words">{label}</h1>
        {event.note && <p class="text-muted-foreground mt-1 break-words">{event.note}</p>}
      </header>

      {error && (
        <Alert variant="destructive" role="alert" className="mb-4">
          <CircleAlert />
          <AlertDescription className="break-words">{error}</AlertDescription>
        </Alert>
      )}

      {plan === null || balance === null ? (
        <Alert variant="destructive" role="alert" className="mb-6">
          <CircleAlert />
          <AlertDescription>Nie udało się wczytać planu.</AlertDescription>
        </Alert>
      ) : (
        <>
          <Card id="bilans" role="region" aria-labelledby="bilans-heading" className={cardClass}>
            <h2 id="bilans-heading" class="mb-2 text-lg font-semibold">
              Bilans miejsc
            </h2>
            <p class="mb-3 break-words">{`${goingLabel(balance.going)} · ${seatsLabel(balance.seats)}`}</p>
            {balance.status === "shortage" && (
              <Alert variant="destructive" role="alert">
                <CircleAlert />
                <AlertDescription className="font-semibold break-words">
                  {missingLabel(balance.missing)}
                </AlertDescription>
              </Alert>
            )}
            {balance.status === "enough" && (
              <Alert variant="success" role="status">
                <CircleCheck />
                <AlertDescription className="font-semibold break-words">Miejsc wystarcza</AlertDescription>
              </Alert>
            )}
            {balance.status === "none_going" && (
              <p class="text-muted-foreground text-sm">Żadne dziecko jeszcze nie jedzie</p>
            )}
          </Card>

          <Card
            id="twoje-dzieci"
            role="region"
            aria-labelledby="twoje-dzieci-heading"
            className={cn(cardClass, "scroll-mt-4")}
          >
            <h2 id="twoje-dzieci-heading" class="mb-3 text-lg font-semibold">
              Twoje dzieci
            </h2>
            {lockedError && (
              <Alert variant="destructive" role="alert" className="mb-3">
                <CircleAlert />
                <AlertDescription className="break-words">{lockedError}</AlertDescription>
              </Alert>
            )}
            {plan.mine.length === 0 ? (
              <p class="text-muted-foreground text-sm">
                Nie masz jeszcze dziecka w tej grupie.{" "}
                <a href={`/groups/${group.id}#dzieci`} class:list={cn(planLinkClass, "text-link inline-flex")}>
                  Dodaj dziecko na stronie grupy
                </a>
              </p>
            ) : (
              <>
                {locked && (
                  <p class="text-muted-foreground mb-3 text-sm">
                    Termin się rozpoczął — deklaracje są tylko do odczytu.
                  </p>
                )}
                <ul class="space-y-3">
                  {plan.mine.map((child) => (
                    <li class:list={listItemClass}>
                      <p class="break-words">
                        <span class="font-medium">{child.name}</span>
                        <span class="text-muted-foreground text-sm"> — {statusLabels[child.status]}</span>
                      </p>
                      {!locked && (
                        <div class="mt-2 grid grid-cols-2 gap-2">
                          {[
                            { going: "true", text: "Jedzie", on: child.status === "going" },
                            { going: "false", text: "Nie jedzie", on: child.status === "not_going" },
                          ].map((choice) => (
                            <form method="POST" action="/api/groups/events/attendance" class="min-w-0">
                              <input type="hidden" name="group_id" value={group.id} />
                              <input type="hidden" name="event_id" value={event.id} />
                              <input type="hidden" name="child_id" value={child.id} />
                              <input type="hidden" name="going" value={choice.going} />
                              <Button
                                type="submit"
                                variant={choice.on ? "default" : "outline"}
                                aria-pressed={choice.on ? "true" : "false"}
                                className={submitClass}
                              >
                                {choice.text}
                              </Button>
                            </form>
                          ))}
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </Card>

          <Card role="region" aria-labelledby="plan-heading" className={cardClass}>
            <h2 id="plan-heading" class="mb-3 text-lg font-semibold">
              Plan dzieci
            </h2>

            <div id="plan-jada" class="mb-4">
              <h3 class="text-muted-foreground mb-2 text-sm font-semibold">Jadą ({plan.going.length})</h3>
              {plan.going.length === 0 ? (
                <p class="text-muted-foreground text-sm">Żadne dziecko jeszcze nie jedzie.</p>
              ) : (
                <ul class="space-y-1 text-sm">
                  {plan.going.map((child) => (
                    <li class="break-words">
                      <span class="font-medium">{child.name}</span>
                      {child.parentNick && <span class="text-muted-foreground"> ({child.parentNick})</span>}
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div id="plan-nie-jada">
              <h3 class="text-muted-foreground mb-2 text-sm font-semibold">Nie jadą ({plan.notGoing.length})</h3>
              {plan.notGoing.length === 0 ? (
                <p class="text-muted-foreground text-sm">Brak dzieci na tej liście.</p>
              ) : (
                <ul class="space-y-1 text-sm">
                  {plan.notGoing.map((child) => (
                    <li class="break-words">
                      <span class="font-medium">{child.name}</span>
                      {child.parentNick && <span class="text-muted-foreground"> ({child.parentNick})</span>}
                      {child.undeclared && (
                        <Badge variant="secondary" className="ml-1">
                          bez deklaracji
                        </Badge>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </Card>

          <Card
            id="twoj-przejazd"
            role="region"
            aria-labelledby="twoj-przejazd-heading"
            className={cn(cardClass, "scroll-mt-4")}
          >
            <h2 id="twoj-przejazd-heading" class="mb-3 text-lg font-semibold">
              Twój przejazd
            </h2>
            {driverError && (
              <Alert variant="destructive" role="alert" id="driver-error" className="mb-3">
                <CircleAlert />
                <AlertDescription className="break-words">{driverError}</AlertDescription>
              </Alert>
            )}
            {locked ? (
              <>
                <p class="mb-2 break-words">
                  {myDriver ? `Jedziesz jako kierowca: ${seatsLabel(myDriver.seats)}` : "Nie jedziesz jako kierowca"}
                </p>
                <p class="text-muted-foreground text-sm">
                  Termin się rozpoczął — deklaracja kierowcy jest tylko do odczytu.
                </p>
              </>
            ) : (
              <>
                {myDriver && <p class="mb-3 break-words">Jedziesz jako kierowca: {seatsLabel(myDriver.seats)}</p>}
                <form method="POST" action="/api/groups/events/driver" class="space-y-2">
                  <input type="hidden" name="group_id" value={group.id} />
                  <input type="hidden" name="event_id" value={event.id} />
                  <input type="hidden" name="action" value="set" />
                  <label for="driver-seats" class:list={labelClass}>
                    Wolne miejsca dla dzieci (1–8)
                  </label>
                  <Input
                    id="driver-seats"
                    name="seats"
                    type="number"
                    inputMode="numeric"
                    min="1"
                    max="8"
                    step="1"
                    required
                    placeholder="np. 3"
                    defaultValue={myDriver ? String(myDriver.seats) : undefined}
                    aria-invalid={seatsInvalid ? "true" : undefined}
                    aria-describedby={seatsInvalid ? "driver-error" : undefined}
                    className={inputClass}
                  />
                  <Button type="submit" className={submitClass}>
                    {myDriver ? "Zapisz miejsca" : "Jadę jako kierowca"}
                  </Button>
                </form>
                {myDriver && (
                  <form method="POST" action="/api/groups/events/driver" class="mt-2">
                    <input type="hidden" name="group_id" value={group.id} />
                    <input type="hidden" name="event_id" value={event.id} />
                    <input type="hidden" name="action" value="withdraw" />
                    <Button type="submit" variant="outline" className={submitClass}>
                      Wycofaj
                    </Button>
                  </form>
                )}
              </>
            )}
          </Card>

          <Card id="kierowcy" role="region" aria-labelledby="kierowcy-heading" className={cardClass}>
            <h2 id="kierowcy-heading" class="mb-3 text-lg font-semibold">
              Kierowcy ({drivers.length})
            </h2>
            {drivers.length === 0 ? (
              <p class="text-muted-foreground text-sm">Nikt jeszcze nie zadeklarował się jako kierowca</p>
            ) : (
              <ul class="space-y-2 text-sm">
                {drivers.map((driver) => (
                  <li class:list={listItemClass}>
                    <p class="break-words">
                      <span class="font-medium">{driver.nick ?? "Członek grupy"}</span>
                      <span class="text-muted-foreground"> — {seatsLabel(driver.seats)}</span>
                    </p>
                    {driver.phone && (
                      <a href={telHref(driver.phone)} class:list={phoneLinkClass}>
                        {driver.phone}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </Card>
        </>
      )}

      <a href={`/groups/${group.id}#terminy`} class:list={linkButtonClass}>
        Wróć do grupy
      </a>
    </div>
  </div>
</Layout>
