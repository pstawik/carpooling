---
import { CircleAlert, Info } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import InvitePanel from "@/components/groups/InvitePanel";
import ChildItem from "@/components/groups/ChildItem";
import EventItem from "@/components/groups/EventItem";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button, buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { createClient } from "@/lib/supabase";
import { getGroupWithAdmins } from "@/lib/services/groups";
import { getGroupInviteToken } from "@/lib/services/invites";
import { listGroupChildren, type GroupChild } from "@/lib/services/children";
import { listGroupEvents, splitEvents, type GroupEventItem } from "@/lib/services/events";
import {
  eventsGeneratedMessage,
  feedbackSection,
  groupErrorMessage,
  groupNoticeMessage,
} from "@/lib/services/group-errors";
import { formatEventStart, utcToWarsawParts } from "@/lib/time";
import { cn } from "@/lib/utils";

// Middleware guarantees a signed-in user on /groups/*. Non-members (including a non-member app
// admin), unknown and malformed ids all get the same 404, so group existence is not leaked.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;
if (!supabase || !user) {
  return Astro.rewrite("/404");
}

const group = await getGroupWithAdmins(supabase, Astro.params.id ?? "", user.id);
if (!group) {
  return Astro.rewrite("/404");
}

// Feedback from the children and events actions lands on #dzieci / #terminy, so it is shown inside
// that card (visible after the jump on a 360 px screen) and skipped in the banner at the top of the page.
const messageCode = Astro.url.searchParams.get("message");
const errorCode = Astro.url.searchParams.get("error");
const messageSection = feedbackSection(messageCode);
const errorSection = feedbackSection(errorCode);
const message = messageSection ? null : groupNoticeMessage(messageCode);
const error = errorSection ? null : groupErrorMessage(errorCode, null);
const childMessage = messageSection === "dzieci" ? groupNoticeMessage(messageCode) : null;
const childError = errorSection === "dzieci" ? groupErrorMessage(errorCode, null) : null;
const eventMessage =
  messageSection !== "terminy"
    ? null
    : messageCode === "events_generated"
      ? eventsGeneratedMessage(Astro.url.searchParams.get("created"), Astro.url.searchParams.get("skipped"))
      : groupNoticeMessage(messageCode);
// After an events mistake, "Zarządzaj terminami" is reopened so the admin sees the forms with the message.
const eventError = errorSection === "terminy" ? groupErrorMessage(errorCode, null) : null;
const weekdays = ["Poniedziałek", "Wtorek", "Środa", "Czwartek", "Piątek", "Sobota", "Niedziela"];
// shadcn Input is h-9; every control on this page stays at least 44 px tall for touch.
const inputClass = "h-auto min-h-11 py-2";
// The native <select> has no ui/ component: it gets the same tokens as Input.
const selectClass =
  "border-input text-foreground focus-visible:border-ring focus-visible:ring-ring/50 dark:bg-input/30 min-h-11 w-full min-w-0 rounded-md border bg-transparent px-3 py-2 text-base shadow-xs outline-none focus-visible:ring-3 md:text-sm";
const labelClass = "text-muted-foreground block text-sm";

// A failed events query must not take the whole group page down either. "Upcoming" is judged
// against one `now` per request, the same moment that marks an event finished.
let events: GroupEventItem[] | null;
try {
  events = await listGroupEvents(supabase, group.id);
} catch (loadError) {
  // eslint-disable-next-line no-console -- surfaces in Cloudflare Worker logs
  console.error(loadError);
  events = null;
}
const now = new Date();
const { upcoming, past } = splitEvents(events ?? [], now);
const todayInWarsaw = utcToWarsawParts(now.toISOString()).date;
const eventPlanHref = (eventId: string) => `/groups/${group.id}/terminy/${eventId}`;
// The date label of every event, upcoming or past, opens its child plan.
const planLinkClass = "flex min-h-11 items-center break-words underline-offset-4 hover:underline";

// A failed children query must not take the whole group page down.
let children: GroupChild[] | null;
try {
  children = await listGroupChildren(supabase, group.id);
} catch (loadError) {
  // eslint-disable-next-line no-console -- surfaces in Cloudflare Worker logs
  console.error(loadError);
  children = null;
}
const myChildren = children?.filter((child) => child.parentId === user.id) ?? [];
const otherChildren = children?.filter((child) => child.parentId !== user.id) ?? [];

// Only admins see the invite section; RLS hides the token from everyone else anyway.
const isAdmin = group.myRole === "admin";
const inviteToken = isAdmin ? await getGroupInviteToken(supabase, group.id) : null;
const inviteUrl = inviteToken ? `${Astro.url.origin}/join/${inviteToken}` : null;

const cardClass = "mb-6 gap-0 p-4 backdrop-blur-xl sm:p-6";
const submitClass = "h-auto min-h-11 w-full whitespace-normal";
const linkButtonClass = cn(buttonVariants({ variant: "outline" }), "h-auto min-h-11 whitespace-normal");
---

<Layout title={group.name}>
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-xl">
      <Topbar />

      <h1 class="text-foreground mb-4 text-2xl font-bold break-words">{group.name}</h1>

      {message && (
        <Alert role="status" className="mb-4">
          <Info />
          <AlertDescription className="break-words">{message}</AlertDescription>
        </Alert>
      )}
      {error && (
        <Alert variant="destructive" role="alert" className="mb-4">
          <CircleAlert />
          <AlertDescription className="break-words">{error}</AlertDescription>
        </Alert>
      )}

      <Card id="terminy" role="region" aria-labelledby="terminy-heading" className={cn(cardClass, "scroll-mt-4")}>
        <h2 id="terminy-heading" class="mb-3 text-lg font-semibold">
          Terminy
        </h2>

        {eventMessage && (
          <Alert role="status" className="mb-3">
            <Info />
            <AlertDescription className="break-words">{eventMessage}</AlertDescription>
          </Alert>
        )}
        {eventError && (
          <Alert variant="destructive" role="alert" className="mb-3">
            <CircleAlert />
            <AlertDescription className="break-words">{eventError}</AlertDescription>
          </Alert>
        )}

        {events === null ? (
          <Alert variant="destructive" role="alert" className="mb-4">
            <CircleAlert />
            <AlertDescription>Nie udało się wczytać terminów.</AlertDescription>
          </Alert>
        ) : (
          <>
            {upcoming.length === 0 ? (
              <p class="text-muted-foreground mb-4 text-sm">Brak nadchodzących terminów.</p>
            ) : (
              <ul class="mb-4 space-y-2">
                {upcoming.map((event) => {
                  const label = formatEventStart(event.startsAt);
                  const { date, time } = utcToWarsawParts(event.startsAt);
                  return (
                    <li>
                      {isAdmin ? (
                        <EventItem
                          groupId={group.id}
                          eventId={event.id}
                          label={label}
                          note={event.note}
                          date={date}
                          time={time}
                          planHref={eventPlanHref(event.id)}
                          client:load
                        />
                      ) : (
                        <>
                          <a href={eventPlanHref(event.id)} class:list={[planLinkClass, "font-medium"]}>
                            {label}
                          </a>
                          {event.note && <p class="text-muted-foreground text-sm break-words">{event.note}</p>}
                        </>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}

            {past.length > 0 && (
              <details class="mb-4">
                <summary class="text-muted-foreground flex min-h-11 cursor-pointer items-center text-sm font-semibold">
                  Minione terminy ({past.length})
                </summary>
                <ul class="mt-2 space-y-2">
                  {past.map((event) => (
                    <li class="text-muted-foreground">
                      <a href={eventPlanHref(event.id)} class:list={planLinkClass}>
                        {formatEventStart(event.startsAt)}
                      </a>
                      {event.note && <p class="text-sm break-words">{event.note}</p>}
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </>
        )}

        <a href={`/groups/${group.id}/statystyki`} class:list={cn(linkButtonClass, "self-start")}>
          Statystyki grupy
        </a>

        {isAdmin && (
          <details class="mt-4" open={Boolean(eventError)}>
            <summary class="text-muted-foreground flex min-h-11 cursor-pointer items-center text-sm font-semibold">
              Zarządzaj terminami
            </summary>

            <form method="POST" action="/api/groups/events" class="mt-2 space-y-2">
              <h3 class="text-sm font-semibold">Dodaj termin</h3>
              <input type="hidden" name="group_id" value={group.id} />
              <div class="grid grid-cols-2 gap-2">
                <div class="min-w-0">
                  <label for="event-date" class:list={labelClass}>
                    Data
                  </label>
                  <Input id="event-date" name="date" type="date" required min={todayInWarsaw} className={inputClass} />
                </div>
                <div class="min-w-0">
                  <label for="event-time" class:list={labelClass}>
                    Godzina
                  </label>
                  <Input id="event-time" name="time" type="time" required className={inputClass} />
                </div>
              </div>
              <label for="event-note" class:list={labelClass}>
                Notatka (opcjonalnie)
              </label>
              <Input
                id="event-note"
                name="note"
                type="text"
                maxLength={200}
                autoComplete="off"
                className={inputClass}
              />
              <Button type="submit" className={submitClass}>
                Dodaj termin
              </Button>
            </form>

            <form method="POST" action="/api/groups/events/generate" class="mt-6 space-y-2">
              <h3 class="text-sm font-semibold">Generuj terminy cotygodniowe</h3>
              <input type="hidden" name="group_id" value={group.id} />
              <div class="grid grid-cols-2 gap-2">
                <div class="min-w-0">
                  <label for="series-weekday" class:list={labelClass}>
                    Dzień tygodnia
                  </label>
                  <select id="series-weekday" name="weekday" required class:list={selectClass}>
                    {weekdays.map((name, index) => (
                      <option value={String(index + 1)}>{name}</option>
                    ))}
                  </select>
                </div>
                <div class="min-w-0">
                  <label for="series-time" class:list={labelClass}>
                    Godzina
                  </label>
                  <Input id="series-time" name="time" type="time" required className={inputClass} />
                </div>
                <div class="min-w-0">
                  <label for="series-from" class:list={labelClass}>
                    Od dnia
                  </label>
                  <Input
                    id="series-from"
                    name="date_from"
                    type="date"
                    required
                    min={todayInWarsaw}
                    className={inputClass}
                  />
                </div>
                <div class="min-w-0">
                  <label for="series-to" class:list={labelClass}>
                    Do dnia (włącznie)
                  </label>
                  <Input
                    id="series-to"
                    name="date_to"
                    type="date"
                    required
                    min={todayInWarsaw}
                    className={inputClass}
                  />
                </div>
              </div>
              <p class="text-muted-foreground text-xs">
                Zakres najwyżej rok. Terminy, które już istnieją albo minęły, zostaną pominięte.
              </p>
              <Button type="submit" className={submitClass}>
                Generuj terminy
              </Button>
            </form>
          </details>
        )}
      </Card>

      <Card id="dzieci" role="region" aria-labelledby="dzieci-heading" className={cn(cardClass, "scroll-mt-4")}>
        <h2 id="dzieci-heading" class="mb-3 text-lg font-semibold">
          Dzieci
        </h2>

        {childMessage && (
          <Alert role="status" className="mb-3">
            <Info />
            <AlertDescription className="break-words">{childMessage}</AlertDescription>
          </Alert>
        )}
        {childError && (
          <Alert variant="destructive" role="alert" className="mb-3">
            <CircleAlert />
            <AlertDescription className="break-words">{childError}</AlertDescription>
          </Alert>
        )}

        {children === null ? (
          <Alert variant="destructive" role="alert" className="mb-4">
            <CircleAlert />
            <AlertDescription>Nie udało się wczytać dzieci.</AlertDescription>
          </Alert>
        ) : (
          <>
            <h3 class="text-muted-foreground mb-2 text-sm font-semibold">Twoje dzieci</h3>
            {myChildren.length === 0 ? (
              <p class="text-muted-foreground mb-4 text-sm">Nie dodałeś jeszcze dziecka.</p>
            ) : (
              <ul class="mb-4 space-y-2">
                {myChildren.map((child) => (
                  <li>
                    <ChildItem groupId={group.id} childId={child.id} name={child.name} client:load />
                  </li>
                ))}
              </ul>
            )}

            {otherChildren.length > 0 && (
              <>
                <h3 class="text-muted-foreground mb-2 text-sm font-semibold">Pozostałe dzieci w grupie</h3>
                <ul class="mb-4 space-y-1 text-sm">
                  {otherChildren.map((child) => (
                    <li class="break-words">
                      <span class="font-medium">{child.name}</span>
                      {child.parentNick && <span class="text-muted-foreground"> ({child.parentNick})</span>}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </>
        )}

        <form method="POST" action="/api/groups/children" class="space-y-2">
          <input type="hidden" name="group_id" value={group.id} />
          <label for="child-name" class:list={labelClass}>
            Imię lub nick dziecka
          </label>
          <Input
            id="child-name"
            name="name"
            type="text"
            required
            maxLength={40}
            autoComplete="off"
            className={inputClass}
          />
          <Button type="submit" className={submitClass}>
            Dodaj dziecko
          </Button>
        </form>
      </Card>

      <Card role="region" aria-labelledby="admins-heading" className={cardClass}>
        <h2 id="admins-heading" class="mb-3 text-lg font-semibold">
          Administratorzy
        </h2>
        {group.admins.length === 0 ? (
          <p class="text-muted-foreground text-sm">Brak administratorów.</p>
        ) : (
          <ul class="space-y-1 text-sm">
            {group.admins.map((admin) => (
              <li class="break-words">
                <span class="font-medium">{admin.first_name}</span>{" "}
                <span class="text-muted-foreground">({admin.nick})</span>
              </li>
            ))}
          </ul>
        )}
      </Card>

      {isAdmin && (
        <Card role="region" aria-labelledby="invite-heading" className={cardClass}>
          <h2 id="invite-heading" class="mb-3 text-lg font-semibold">
            Link zaproszeniowy
          </h2>
          {inviteUrl ? (
            <InvitePanel url={inviteUrl} groupId={group.id} client:load />
          ) : (
            <form method="POST" action="/api/groups/invite" class="space-y-3">
              <p class="text-muted-foreground text-sm">
                Grupa nie ma jeszcze linku. Każdy, kto go otrzyma, będzie mógł dołączyć do grupy.
              </p>
              <input type="hidden" name="group_id" value={group.id} />
              <Button type="submit" className={submitClass}>
                Wygeneruj link
              </Button>
            </form>
          )}
        </Card>
      )}

      <a href="/dashboard" class:list={linkButtonClass}>
        Wróć do panelu
      </a>
    </div>
  </div>
</Layout>
