---
import { CircleCheck, Info } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { cardClass, hintLinkClass } from "@/components/groups/group-page-classes";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card } from "@/components/ui/card";
import { authErrorMessage, noticeMessage } from "@/lib/services/auth-errors";
import { optionalInviteToken } from "@/lib/validation/invites";
import { cn } from "@/lib/utils";

const error = authErrorMessage(Astro.url.searchParams.get("error"));
const message = noticeMessage(Astro.url.searchParams.get("message"));
// Only a well-formed token is carried on; anything else is dropped silently.
const invite = optionalInviteToken(Astro.url.searchParams.get("invite"));

// A signed-in user has nothing to do here: send them on, to the invite when they came with one.
if (Astro.locals.user) {
  return Astro.redirect(invite ? `/join/${invite}` : "/dashboard");
}
---

<Layout title="Logowanie">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className={cn(cardClass, "mb-0 w-full max-w-sm")}>
      <h1 class="text-foreground mb-6 text-center text-2xl font-bold">Logowanie</h1>
      {message && (
        <Alert variant="success" role="status" className="mb-4">
          <CircleCheck />
          <AlertDescription className="break-words">{message}</AlertDescription>
        </Alert>
      )}
      {invite && (
        <Alert role="status" className="mb-4">
          <Info />
          <AlertDescription className="break-words">Po zalogowaniu dołączysz do grupy.</AlertDescription>
        </Alert>
      )}
      <SignInForm serverError={error} invite={invite} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Nie masz konta?{" "}
        <a href={invite ? `/auth/signup?invite=${invite}` : "/auth/signup"} class:list={hintLinkClass}>
          Zarejestruj się
        </a>
      </p>
    </Card>
  </div>
</Layout>
