---
import { CircleAlert } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { cardClass, groupLinkClass, primaryLinkButtonClass } from "@/components/groups/group-page-classes";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import { createClient } from "@/lib/supabase";
import { listMyGroups, type MyGroup } from "@/lib/services/groups";
import { cn } from "@/lib/utils";

const { user, profile, isAppAdmin } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let groups: MyGroup[] = [];
let groupsFailed = false;
if (supabase && user) {
  try {
    groups = await listMyGroups(supabase, user.id);
  } catch (err) {
    // eslint-disable-next-line no-console -- surfaces in Cloudflare Worker logs
    console.error(err instanceof Error ? err.message : err);
    groupsFailed = true;
  }
}
---

<Layout title="Panel">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-xl">
      <Topbar />

      <h1 class="text-foreground mb-4 text-2xl font-bold break-words">
        {profile ? `Cześć, ${profile.first_name}!` : "Cześć!"}
      </h1>

      <Card id="grupy" role="region" aria-labelledby="grupy-heading" className={cn(cardClass, "scroll-mt-4")}>
        <h2 id="grupy-heading" class="mb-3 text-lg font-semibold">
          Twoje grupy
        </h2>
        {groupsFailed ? (
          <Alert variant="destructive" role="alert">
            <CircleAlert />
            <AlertDescription className="break-words">
              Nie udało się wczytać grup. Spróbuj ponownie później.
            </AlertDescription>
          </Alert>
        ) : groups.length === 0 ? (
          <p class="text-muted-foreground text-sm">
            Nie należysz jeszcze do żadnej grupy. Poproś administratora grupy o link zaproszeniowy.
          </p>
        ) : (
          <ul class="space-y-2">
            {groups.map((group) => (
              <li>
                <a href={`/groups/${group.id}`} class:list={groupLinkClass}>
                  <span class="min-w-0 font-medium break-words">{group.name}</span>
                  {group.role === "admin" && <Badge>administrator</Badge>}
                </a>
              </li>
            ))}
          </ul>
        )}
      </Card>

      {isAppAdmin && (
        <a href="/admin/groups" class:list={primaryLinkButtonClass}>
          Panel administratora
        </a>
      )}
    </div>
  </div>
</Layout>
