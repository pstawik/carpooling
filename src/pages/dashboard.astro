---
import { CircleAlert } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import { cardClass, groupLinkClass, linkButtonClass } from "@/components/groups/group-page-classes";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { createClient } from "@/lib/supabase";
import { listMyGroups, type MyGroup } from "@/lib/services/groups";
import { cn } from "@/lib/utils";

const { user, profile, isAppAdmin } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let groups: MyGroup[] = [];
let groupsFailed = false;
if (supabase && user) {
  try {
    groups = await listMyGroups(supabase, user.id);
  } catch (err) {
    // eslint-disable-next-line no-console -- surfaces in Cloudflare Worker logs
    console.error(err instanceof Error ? err.message : err);
    groupsFailed = true;
  }
}
---

<Layout title="Panel">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className={cn(cardClass, "w-full max-w-sm text-center")}>
      <h1 class="text-foreground mb-4 text-3xl font-bold break-words">
        {profile ? `Cześć, ${profile.first_name}!` : "Cześć!"}
      </h1>
      <p class="text-muted-foreground break-words">
        {profile ? (
          <>
            Twój nick: <span class="text-foreground font-semibold">{profile.nick}</span>
          </>
        ) : (
          <>
            Zalogowano jako <span class="text-foreground font-semibold">{user?.email}</span>
          </>
        )}
      </p>
      <section class="mt-6 text-left">
        <h2 class="mb-3 text-lg font-semibold">Twoje grupy</h2>
        {groupsFailed ? (
          <Alert variant="destructive" role="alert">
            <CircleAlert />
            <AlertDescription className="break-words">
              Nie udało się wczytać grup. Spróbuj ponownie później.
            </AlertDescription>
          </Alert>
        ) : groups.length === 0 ? (
          <p class="text-muted-foreground text-sm">Nie należysz jeszcze do żadnej grupy.</p>
        ) : (
          <ul class="space-y-2">
            {groups.map((group) => (
              <li>
                <a href={`/groups/${group.id}`} class:list={groupLinkClass}>
                  <span class="min-w-0 font-medium break-words">{group.name}</span>
                  {group.role === "admin" && <Badge>administrator</Badge>}
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
      {isAppAdmin && (
        <a href="/admin/groups" class:list={cn(buttonVariants(), "mt-6 h-auto min-h-11 self-center")}>
          Panel administratora
        </a>
      )}
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button type="submit" class:list={linkButtonClass}>
          Wyloguj
        </button>
      </form>
    </Card>
  </div>
</Layout>
