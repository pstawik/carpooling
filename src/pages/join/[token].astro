---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { createClient } from "@/lib/supabase";
import { getInviteGroupName } from "@/lib/services/invites";
import { inviteTokenSchema } from "@/lib/validation/invites";

// Public route: opening a link never changes data; joining is the POST form below.
// A malformed, unknown or regenerated token all render the same "nieaktualny" card with 404.
const { user } = Astro.locals;
const parsed = inviteTokenSchema.safeParse(Astro.params.token);
const token = parsed.success ? parsed.data : null;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const groupName = token && supabase ? await getInviteGroupName(supabase, token) : null;

if (!groupName) {
  Astro.response.status = 404;
}

const cardClass =
  "w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-6 text-center text-white backdrop-blur-xl sm:p-8";
const headingClass =
  "mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold break-words text-transparent";
const primaryClass =
  "inline-flex h-auto min-h-11 w-full items-center justify-center rounded-lg bg-purple-600 px-4 py-2 font-medium whitespace-normal text-white transition-colors hover:bg-purple-500";
const secondaryClass =
  "inline-flex min-h-11 w-full items-center justify-center rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20";
---

<Layout title={groupName ? "Zaproszenie do grupy" : "Link nieaktualny"}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class:list={cardClass}>
      {!groupName || !token ? (
        <>
          <h1 class:list={headingClass}>Link nieaktualny</h1>
          <p class="text-blue-100/80">Ten link jest nieaktualny — poproś administratora grupy o nowy.</p>
          <a href={user ? "/dashboard" : "/"} class:list={[secondaryClass, "mt-6"]}>
            {user ? "Wróć do panelu" : "Strona główna"}
          </a>
        </>
      ) : (
        <>
          <h1 class:list={headingClass}>Zaproszenie do grupy „{groupName}”</h1>
          {user ? (
            <form method="POST" action="/api/groups/join" class="mt-6">
              <input type="hidden" name="token" value={token} />
              <Button type="submit" className={primaryClass}>
                Dołącz do grupy
              </Button>
            </form>
          ) : (
            <div class="mt-6 space-y-3">
              <p class="text-sm text-blue-100/80">Załóż konto albo zaloguj się, aby dołączyć do grupy.</p>
              <a href={`/auth/signup?invite=${token}`} class:list={primaryClass}>
                Załóż konto
              </a>
              <a href={`/auth/signin?invite=${token}`} class:list={secondaryClass}>
                Mam konto — zaloguj się
              </a>
            </div>
          )}
        </>
      )}
    </div>
  </div>
</Layout>
